# Copy to .env (never commit real keys). The CLI/API read these from the environment.

# fake | openai | anthropic | gemini | ollama | replay
DOCFUNNEL_PROVIDER=fake
# Defaults per provider: fake-mini, gpt-6-luna, claude-haiku-5-5, gemini-3.5-flash-lite, gemma4:12b-mlx
DOCFUNNEL_MODEL=
# Comma-separated fallback chain, e.g. "openai:gpt-6.1-terra,anthropic:claude-sonnet-5-5"
DOCFUNNEL_FALLBACK=fake:fake-pro
# What the model is sent for a PDF or image: text | hybrid | hybrid-ocr | native
DOCFUNNEL_ROUTE=text
DOCFUNNEL_MAX_ATTEMPTS=3
# Long invoices need ~16000
DOCFUNNEL_MAX_OUTPUT_TOKENS=2048
DOCFUNNEL_BACKOFF_BASE_S=0.5
DOCFUNNEL_REVIEW_MIN_CONFIDENCE=0.7
# Optional: custom price table (USD per 1M tokens), cassette for replay, API file input dir
DOCFUNNEL_PRICING_FILE=
DOCFUNNEL_CASSETTE=
DOCFUNNEL_INPUT_DIR=
# Sources given as URLs (CLI, MCP): download limits and private-host blocking
DOCFUNNEL_ALLOW_URLS=1
DOCFUNNEL_ALLOW_PRIVATE_URLS=0
DOCFUNNEL_MAX_DOWNLOAD_MB=50

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Ollama server for the ollama provider
OLLAMA_HOST=http://localhost:11434
