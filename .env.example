# Copy to .env (never commit real keys). The CLI/API read these from the environment.

# fake | openai | anthropic | gemini | replay
DOCFUNNEL_PROVIDER=fake
# Defaults per provider: fake-mini, gpt-4o-mini, claude-haiku-4-5, gemini-2.5-flash
DOCFUNNEL_MODEL=
# Comma-separated fallback chain, e.g. "openai:gpt-4.1-mini,anthropic:claude-sonnet-4-5"
DOCFUNNEL_FALLBACK=fake:fake-pro
DOCFUNNEL_MAX_ATTEMPTS=3
DOCFUNNEL_BACKOFF_BASE_S=0.5
DOCFUNNEL_REVIEW_MIN_CONFIDENCE=0.7
# Optional: custom price table (USD per 1M tokens), cassette for replay, API file input dir
DOCFUNNEL_PRICING_FILE=
DOCFUNNEL_CASSETTE=
DOCFUNNEL_INPUT_DIR=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
